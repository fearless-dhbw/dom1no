@startuml architecture-overview
!pragma layout smetana
title DOM1NO — High-Level Architecture (UML Component Diagram)
top to bottom direction
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam packageStyle folder
skinparam componentStyle uml2
skinparam nodesep 35
skinparam ranksep 42

package ":client (Kotlin Multiplatform + Compose Multiplatform — MVVM)" as Client #F7F9FC {
  package "View" as ClientView #E8F1FD {
    [MatchScreen &\nLobby Views] as MatchView
    [FriendsScreen &\nChat Views] as SocialView
  }

  package "ViewModel" as ClientVM #FFF4E5 {
    [MatchViewModel] as MatchVM
    [FriendsViewModel] as SocialVM
  }

  package "Model / Transport (:shared Protobuf)" as ClientNet #EAF7EE {
    [MatchSocketClient] as SocketClient
    [SocialApiClient] as HttpClient
  }

  MatchView ..> MatchVM : observes UiState /\ndispatches actions
  SocialView ..> SocialVM : observes UiState /\ndispatches actions
  MatchVM ..> SocketClient : match commands &\nstate updates
  SocialVM ..> HttpClient : REST / CRUD\nrequests
}

package ":server (Kotlin + Spring Boot — Controller–Service–Repository)" as Server #FAF9F6 {
  package "Controller" as ServerCtrl #FFF4E5 {
    [MatchWebSocketController] as WsCtrl
    [FriendController &\nAuth / Room / Chat REST] as RestCtrl
  }

  package "Service & Authoritative Domain Model" as ServerDomain #EAF7EE {
    [MatchService\n(active match state\n& synchronization)] as MatchSvc
    [Domino Rules Engine\n(Match, Board, Seat, Tile)] as Rules
    [FriendService &\nAccount / Room / Chat] as SocialSvc
  }

  package "Repository (Spring Data JPA)" as ServerRepo #F2EEFA {
    [MatchRepository] as MatchRepo
    [Player / Friend / Chat\nRepositories] as SocialRepo
  }

  WsCtrl ..> MatchSvc : validates turn,\nactor & match
  MatchSvc ..> Rules : enforces\ngame rules
  MatchSvc ..> MatchRepo : persists rooms\n& match outcomes
  RestCtrl ..> SocialSvc : delegates CRUD\n& domain checks
  SocialSvc ..> SocialRepo : Spring Data JPA
}

database "PostgreSQL\n(dom1no_db)" as DB #EFEFEF

SocketClient ..> WsCtrl : <<WebSocket + Protobuf>>\nmatch commands
WsCtrl ..> SocketClient : <<WebSocket + Protobuf>>\nper-player state
HttpClient ..> RestCtrl : <<HTTP + Protobuf>>\nGET / POST / PUT / DELETE
MatchRepo ..> DB : <<JDBC / SQL>>
SocialRepo ..> DB : <<JDBC / SQL>>

caption Shared wire models live in :shared (kotlinx.serialization-protobuf).\nLive hands, boneyard and turn order remain authoritative in MatchService; each player receives only their own hand.
@enduml
